<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Hardened runtime blocks everything that is not explicitly allowed. The
      app hosts WKWebView, which compiles JavaScript at runtime, so the JIT
      entitlement is mandatory: without it the webview renders a blank page
      and the console reports a security violation instead of an error.

      Library validation is disabled because the app loads the WebKit
      framework the system provides and the updater swaps the Mach-O inside
      the bundle, which would otherwise invalidate the signed library list.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The app talks to harness CLIs and a local bridge socket. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <!--
      Not a sandboxed app: the whole product administers files under the
      operator's home (~/.claude, ~/.codex, ...), which a sandbox would deny.
      No app-sandbox entitlement is declared for that reason.
    -->
</dict>
</plist>
