{
  "name": "ownhub",
  "private": true,
  "version": "0.1.0-alpha.11",
  "type": "module",
  "description": "OwnHub — Universal AI Harness Administration Platform",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:ui && tsc --noEmit && vite build && npm run check:bundle",
    "build:fast": "npm run build && cd src-tauri && cargo build --features custom-protocol",
    "build:release": "tauri build --no-bundle",
    "dev:tauri": "tauri dev",
    "tauri:dev": "tauri dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:ui": "node scripts/check-card-motion.mjs",
    "check:lines": "node scripts/check-line-cap.mjs",
    "check:bundle": "node scripts/check-dev-bundle.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --test 'scripts/**/*.test.mjs'",
    "test:visual": "node scripts/visual-snapshots.mjs",
    "test:all": "npm run check:ui && node --test 'scripts/**/*.test.mjs' && cargo test",
    "scaffold:extensions": "sh scripts/scaffold-extensions-monorepo.sh",
    "version:bump": "node scripts/bump-version.mjs",
    "version:check": "node scripts/bump-version.mjs --check",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
