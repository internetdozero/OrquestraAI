# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Rust / Tauri
# Cargo resolves this repo as a workspace, so artifacts land in the root
# `target/` — not only `src-tauri/target/`. Both must be ignored, otherwise
# every git status and Tailwind content scan walks ~20 GB of build output.
/target/
src-tauri/target/
src-tauri/gen/schemas/
/tools/windows-typecheck/target/

# Agent scratch state (scratch files, session logs, evidence)
.freebuff/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log* 
# Environment, secrets, and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.sqlite
*.sqlite3
*.db
secrets.json
mcp_config.json
*.tar.gz
PRD.md

# Local-only Cargo overrides (machine-specific sccache/clang/mold).
# See .cargo/config.local.toml.example — the committed .cargo/config.toml
# stays portable and auto-includes this file when present.
.cargo/config.local.toml

# Flatpak packaging output: `scripts/build-flatpak.sh` stages the binary,
# launcher and icons beside the manifest and writes the bundle into the repo
# root. Neither is source.
packaging/flatpak/files/
*.flatpak

# Orquestra audits
.orquestra/audits/
